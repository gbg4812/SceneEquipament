// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug Current",
    "request": "launch",
    "build": {
      "command": "./debug.sh",
      "cwd": "$ZED_WORKTREE_ROOT",
    },
    "program": "$ZED_WORKTREE_ROOT/build-debug/$ZED_STEM",
    "cwd": "$ZED_WORKTREE_ROOT/build-debug/",
    "adapter": "CodeLLDB",
  },
]
